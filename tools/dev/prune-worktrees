#!/usr/bin/env bash
# Remove agent worktrees under .claude/worktrees/ that are finished: clean,
# fully merged into origin/main, and not in use by a running session.
#
#   tools/dev/prune-worktrees            remove them
#   tools/dev/prune-worktrees -n         only say what would be removed
#   tools/dev/prune-worktrees --quiet    print nothing unless something was removed
#
# Anything with uncommitted files or unmerged commits is kept, so a worktree
# is never removed with work in it. Runs from any worktree of the repo.
set -euo pipefail

dry_run=0
quiet=0
for arg in "$@"; do
    case "$arg" in
        -n|--dry-run) dry_run=1 ;;
        -q|--quiet) quiet=1 ;;
        *) echo "usage: prune-worktrees [-n] [--quiet]" >&2; exit 2 ;;
    esac
done

say() { (( quiet )) || echo "$@"; }

# The main checkout owns .claude/worktrees/, whichever worktree we run from.
main=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
dir=$main/.claude/worktrees
[[ -d $dir ]] || exit 0
git -C "$main" fetch -q origin 2>/dev/null || { say "prune-worktrees: fetch failed; skipping"; exit 0; }

# True if a live process has its working directory inside $1 (a running
# session or a shell someone left there). Linux reads /proc; elsewhere lsof.
in_use() {
    local path=$1 link
    if [[ -d /proc/self/cwd ]]; then
        for link in /proc/[0-9]*/cwd; do
            case $(readlink "$link" 2>/dev/null) in "$path" | "$path"/*) return 0 ;; esac
        done
        return 1
    fi
    command -v lsof >/dev/null && lsof -a -d cwd -Fn 2>/dev/null | grep -q "^n$path"
}

# Prints the lock's pid if the worktree is locked by a process still alive.
locked_by_live_pid() {
    local path=$1 reason pid
    reason=$(git -C "$main" worktree list --porcelain |
        awk -v p="$path" '$1=="worktree"{cur=$2} cur==p && $1=="locked"{sub(/^locked ?/,""); print; exit}')
    pid=$(sed -n 's/.*pid \([0-9]*\).*/\1/p' <<<"$reason")
    [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

# True if the worktree's index changed in the last two hours. A session that
# has just created its worktree has no commits yet and would otherwise look
# merged.
recently_active() {
    local index
    index=$(git -C "$1" rev-parse --path-format=absolute --git-path index)
    [[ -n $(find "$index" "$1" -maxdepth 0 -mmin -120 2>/dev/null) ]]
}

removed=0
for wt in "$dir"/*/; do
    wt=${wt%/}
    [[ -e $wt/.git ]] || continue
    name=${wt#"$main"/}
    if in_use "$wt" || locked_by_live_pid "$wt" || recently_active "$wt"; then
        say "keep $name: in use or active in the last 2 h"
        continue
    fi
    if [[ -n $(git -C "$wt" status --porcelain 2>/dev/null) ]]; then
        say "keep $name: uncommitted changes"
        continue
    fi
    if ! git -C "$wt" merge-base --is-ancestor HEAD origin/main 2>/dev/null; then
        say "keep $name: commits not on origin/main"
        continue
    fi
    branch=$(git -C "$wt" symbolic-ref -q --short HEAD || true)
    if (( dry_run )); then
        echo "would remove $name${branch:+ (branch $branch)}"
        continue
    fi
    git -C "$main" worktree unlock "$wt" 2>/dev/null || true
    git -C "$main" worktree remove "$wt"
    # Safe: HEAD was just checked to be on origin/main.
    [[ -n $branch ]] && git -C "$main" branch -D -q "$branch" 2>/dev/null || true
    echo "removed $name${branch:+ (branch $branch)}"
    removed=$((removed + 1))
done
git -C "$main" worktree prune
(( removed == 0 )) && say "prune-worktrees: nothing to remove"
exit 0
