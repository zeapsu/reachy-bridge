# Default Backend: OpenAI Realtime (Low-latency WebSocket voice)
OPENAI_API_KEY=your_key_here
# Optional: specify a different model (default: gpt-realtime)
# OPENAI_REALTIME_MODEL=gpt-realtime

# Alternative: Gemini Live (Real-time conversation with Google's Gemini)
# BACKEND_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here
# Or use Google API key instead:
# GOOGLE_API_KEY=your_key_here

# Alternative: OpenRouter Chat (Turn-based local speech pipeline: mic → whisper → LLM → TTS → speaker)
# BACKEND_PROVIDER=openai
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=minimax/minimax-m3

# Alternative: Hugging Face Realtime
# BACKEND_PROVIDER=huggingface
# Optional: Hugging Face token for accessing gated models
# HF_TOKEN=your_key_here

# Optional Media Backend (default: local, required for Reachy Mini Lite)
# REACHY_MINI_MEDIA_BACKEND=local

# Optional: Skip .env loading (use environment variables only)
# REACHY_MINI_SKIP_DOTENV=1
