                # A short number is the device's line in `reachy-bridge devices`;
                # ids are 12 hex characters.
                if [[ $id =~ ^[0-9]{1,4}$ ]]; then
                    command -v python3 >/dev/null || die "revoking by number needs python3; pass the id instead"
                    list=$(controller_api GET /api/auth/devices)
                    id=$(python3 -c '
