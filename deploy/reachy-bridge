        ;;
    uninstall)
        # Exit from inside the case: this removes the file bash is reading.
        (( ! force )) || die "usage: reachy-bridge uninstall [--keep-data] [--dry-run] [--yes]"
        uninstall_bridge "${args[@]}"
        exit
        ;;
    robot-power)
        # For install.sh: off, on or unknown (see robot_power).
        robot_power
        ;;
    -h|--help|help)
        sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
