#!/usr/bin/env bash
# reachy-bridge: manage the bridge's user services and its tailnet mappings.
# Replaces the old reachy-up / reachy-down shell functions (#130).
#
#   reachy-bridge status
#   reachy-bridge start | stop | restart [daemon|controller]   (default: both)
#   reachy-bridge logs [daemon|controller]
#   reachy-bridge serve [on|off|status]
#
# Stopping the daemon sends SIGINT, which puts the robot to sleep and releases
# torque. Restarting the daemon is refused while the robot is on, unless
# --force is given: the restart would put it to sleep mid-whatever.
set -euo pipefail

DAEMON=reachy-bridge.service
CONTROLLER=reachy-bridge-controller.service
DAEMON_URL=${DAEMON_URL:-http://127.0.0.1:8000}

# tailscale serve: dedicated HTTPS ports only. Never the root mapping, never
# `tailscale serve reset` (other services share this node's serve config).
# WebRTC signalling (:8443) and app UIs (:8042, :7860, ...) bind 0.0.0.0
# themselves, so a serve listener on the same port would make their bind fail
# at power-on: never serve those port numbers. Browsers don't need :8443
# (remote WebRTC goes through the central relay over HTTPS). App UIs are
# reached through :8043 instead, the controller's app proxy, which forwards
# to whichever app is running; nothing on the device binds 8043.
SERVE_CONTROLLER_PORT=${REACHY_BRIDGE_SERVE_PORT:-10000}
SERVE_MAPPINGS=(
    "$SERVE_CONTROLLER_PORT http://127.0.0.1:${CONTROLLER_PORT:-7861}"  # dashboard
    "8043 http://127.0.0.1:${CONTROLLER_APP_PORT:-7863}"  # running app's UI (controller proxy)
)

die() { echo "reachy-bridge: $*" >&2; exit 1; }

# Sets UNITS to the units a service name stands for.
units_for() {
    case "${1:-all}" in
        all) UNITS=("$DAEMON" "$CONTROLLER") ;;
        daemon) UNITS=("$DAEMON") ;;
        controller) UNITS=("$CONTROLLER") ;;
        *) die "unknown service '$1' (daemon, controller)" ;;
    esac
}

# Prints off, on or unknown. Fails closed: only a refused connection (no
# daemon listening) or a daemon reporting no backend counts as off. A slow or
# busy daemon is unknown, never off, so nothing restarts it mid-motion.
robot_power() {
    local status rc=0
    status=$(curl -s -m 5 "$DAEMON_URL/api/daemon/status") || rc=$?
    if (( rc == 7 )); then echo off; return; fi
    if (( rc != 0 )); then echo unknown; return; fi
    if [[ $status == *'"backend_status":null'* ]] &&
        [[ $status == *'"state":"stopped"'* || $status == *'"state":"not_initialized"'* || $status == *'"state":"error"'* ]]; then
        echo off
    elif [[ $status == *'"state":"'* ]]; then
        echo on
    else
        echo unknown
    fi
}

robot_state() {
    local status
    status=$(curl -s -m 2 "$DAEMON_URL/api/daemon/status") || { echo "daemon not answering"; return; }
    local state=${status#*\"state\":\"}
    state=${state%%\"*}
    local mode=""
    [[ $status == *'"motor_control_mode":"'* ]] && { mode=${status#*\"motor_control_mode\":\"}; mode=" (motors ${mode%%\"*})"; }
    echo "$state$mode"
}

tailscale_serve() {
    # Without an operator set, tailscale serve needs root.
    if tailscale serve "$@" 2>/dev/null; then return 0; fi
    sudo tailscale serve "$@"
}

cmd=${1:-status}
shift || true
force=0
args=()
for arg in "$@"; do
    if [[ $arg == --force ]]; then force=1; else args+=("$arg"); fi
done

case "$cmd" in
    status)
        systemctl --user --no-pager --lines=0 status $DAEMON $CONTROLLER || true
        echo "robot: $(robot_state)"
        ;;
    start)
        units_for "${args[0]:-all}"
        systemctl --user start "${UNITS[@]}"
        ;;
    stop)
        units_for "${args[0]:-all}"
        systemctl --user stop "${UNITS[@]}"
        ;;
    restart)
        units_for "${args[0]:-all}"
        if [[ " ${UNITS[*]} " == *" $DAEMON "* ]] && (( ! force )) && [[ $(robot_power) != off ]]; then
            die "the robot isn't confirmed off ($(robot_state)); turn it off first, or pass --force"
        fi
        systemctl --user restart "${UNITS[@]}"
        ;;
    logs)
        case "${args[0]:-daemon}" in
            daemon) unit=$DAEMON ;;
            controller) unit=$CONTROLLER ;;
            *) die "unknown service '${args[0]}'" ;;
        esac
        # --user-unit reads the system journal, where user services log when
        # the user journal isn't persistent (the Jetson default).
        exec journalctl --user-unit="$unit" -f -n 200
        ;;
    serve)
        command -v tailscale >/dev/null || die "tailscale is not installed"
        case "${args[0]:-on}" in
            on)
                for mapping in "${SERVE_MAPPINGS[@]}"; do
                    read -r port target <<<"$mapping"
                    tailscale_serve --bg --https="$port" "$target"
                done
                tailscale serve status
                ;;
            off)
                for mapping in "${SERVE_MAPPINGS[@]}"; do
                    read -r port _ <<<"$mapping"
                    tailscale_serve --https="$port" off || true
                done
                ;;
            status) tailscale serve status ;;
            *) die "serve takes on, off or status" ;;
        esac
        ;;
    robot-power)
        # For install.sh: off, on or unknown (see robot_power).
        robot_power
        ;;
    -h|--help|help)
        sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        die "unknown command '$cmd' (try: reachy-bridge help)"
        ;;
esac
