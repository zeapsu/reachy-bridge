    deploy)
        # Exit from inside the case: install.sh replaces this file, and bash
        # would otherwise read on from the new one.
        (( ${#args[@]} == 1 && ! force )) && [[ ${args[0]} != -* ]] || die "usage: reachy-bridge deploy <tag>"
        deploy_tag "${args[0]}"
