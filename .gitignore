# --- Python ---
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.eggs/
build/
dist/
*.so

# --- Rust / web builds ---
/controller/target/
node_modules/

# --- Virtual environments ---
.venv/
venv/
env/
# Community apps the daemon installs next to its venv (a dev daemon run from
# the checkout puts them here).
/apps_venv/

# --- Secrets & local config (keep the examples) ---
.env
*.local.env
*.local.sh
!.env.example

# --- Operator-local agent instructions (AGENTS.md and CLAUDE.md are public) ---
CLAUDE.local.md

# --- Model / data caches ---
.cache/
models/
*.bin
*.pt
*.onnx

# --- Reachy daemon machine-specific app metadata ---
.app_metadata/

# --- OS noise ---
.DS_Store
Thumbs.db

# --- Third-party upstream clones (cloned for reference; not this project's source) ---
/reachy_mini/
/reachy_mini_conversation_app/

# --- Agent scratch / local QA artifacts (not committed) ---
# .claude/ is local except the shared settings, their hooks and skills.
/.claude/*
!/.claude/settings.json
!/.claude/hooks/
!/.claude/skills/
/.superpowers/
/.playwright-mcp/
/.reachy-logs/

# --- Browser test output ---
/web/test-results/
/web/playwright-report/

# --- Coverage ---
/.coverage
